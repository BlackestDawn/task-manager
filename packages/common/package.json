{
  "name": "@task-manager/common",
  "module": "index.ts",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target node --format esm --splitting && bunx tsc --emitDeclarationOnly --declaration --declarationMap --outDir dist",
    "dev": "bun --watch src/index.ts",
    "clean": "rm -rf dist *.tsbuildinfo",
    "test": "vitest --run"
  },
  "private": true,
  "devDependencies": {
    "@types/bun": "latest",
    "vitest": "^3.2.7"
  },
  "peerDependencies": {
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@casl/ability": "^6.7.3",
    "zod": "^4.1.12"
  }
}

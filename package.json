{
  "name": "task-manager",
  "description": "Task Manager",
  "private": true,
  "version": "0.0.1",
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "clean": "bun --filter '*' clean",
    "build:backend": "bun --filter @task-manager/backend build",
    "build:frontend": "bun --filter @task-manager/frontend build",
    "build:common": "bun --filter @task-manager/common build",
    "build": "bun run build:common && concurrently 'bun run build:backend' 'bun run build:frontend'",
    "dev:backend": "bun --elide-lines=80 --filter @task-manager/backend dev",
    "dev:frontend": "bun --elide-lines=80 --filter @task-manager/frontend dev",
    "dev:common": "bun --filter @task-manager/common dev",
    "dev": "bun run build:common && concurrently 'bun run dev:backend' 'bun run dev:frontend'",
    "generate": "bun --filter @task-manager/backend db:generate",
    "migrate": "bun --filter @task-manager/backend db:migrate",
    "test:backend": "bun --filter @task-manager/backend test",
    "test:frontend": "bun --filter @task-manager/frontend test",
    "test:common": "bun --filter @task-manager/common test",
    "test": "vitest --run",
    "lint:frontend": "bun --filter @task-manager/frontend lint",
    "typecheck:backend": "tsc --noEmit -p packages/backend/tsconfig.json",
    "typecheck:common": "tsc --noEmit -p packages/common/tsconfig.json",
    "lint": "bun run build:common && concurrently 'bun run lint:frontend' 'bun run typecheck:backend' 'bun run typecheck:common'"
  },
  "module": "index.ts",
  "type": "module",
  "devDependencies": {
    "@types/bun": "latest",
    "concurrently": "^9.2.1",
    "dotenv": "^17.2.3"
  },
  "peerDependencies": {
    "typescript": "^5.8.3"
  }
}

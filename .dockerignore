# Docker ignore file for Task Manager
# Excludes unnecessary files from Docker build context

# Git
.git
.gitignore
.gitattributes

# Docker
Dockerfile
docker-compose*.yml
.dockerignore
.docker

# Documentation
*.md
README*
CHANGELOG*
LICENSE
docs/

# Environment files
.env
.env.*
!.env.example

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Node modules (will be installed in container)
node_modules/
**/node_modules/

# Build outputs
dist/
build/
out/
.next/
**/.next/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Testing
coverage/
*.lcov
.nyc_output/
test-results/
**/__tests__/
**/*.test.ts
**/*.test.js
**/*.spec.ts
**/*.spec.js

# Cache directories
.cache/
.parcel-cache/
.eslintcache
*.tsbuildinfo

# Temporary files
tmp/
temp/
*.tmp
*.temp

# OS files
Thumbs.db
Desktop.ini

# Backup files
*.bak
*.backup
*~

# Package manager files
package-lock.json
yarn.lock
pnpm-lock.yaml

# Development tools
.husky/
.commitlintrc*
.prettierrc*
.prettierignore
.editorconfig

# CI/CD
.github/
.gitlab-ci.yml
.travis.yml
circle.yml

# Database files
*.sqlite
*.sqlite3
*.db

# Migrations (included separately)
# packages/backend/src/db/migrations/

# Sample and test data (exclude from production builds)
**/sample_data.sql
**/test_data.sql

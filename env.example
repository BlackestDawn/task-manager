# Environment Configuration for Task Manager Docker Setup
# Copy this file to .env and update the values as needed

# ============================================
# APPLICATION SETTINGS
# ============================================

# Environment mode: development or production
NODE_ENV=production

# Platform: dev or prod (affects security settings)
PLATFORM=prod

# ============================================
# DATABASE SETTINGS
# ============================================

# PostgreSQL database name
POSTGRES_DB=taskmanager

# PostgreSQL username
POSTGRES_USER=taskmanager

# PostgreSQL password (CHANGE THIS IN PRODUCTION!)
POSTGRES_PASSWORD=taskmanager_password

# PostgreSQL port (external access)
POSTGRES_PORT=5432

# ============================================
# BACKEND SETTINGS
# ============================================

# Backend server port
PORT=3020

# Full database connection URL (automatically constructed from above settings)
# DB_URL will be set automatically in docker-compose.yml
# Format: postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}

# JWT Secret key (CHANGE THIS IN PRODUCTION!)
# Generate a secure random string: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Application domain (for CORS)
APP_DOMAIN=http://localhost:3000

# ============================================
# FRONTEND SETTINGS
# ============================================

# API URL for frontend to connect to backend
# For Docker: use http://backend:3020/api (internal network)
# For external access: use http://localhost:3020/api
NEXT_PUBLIC_API_URL=http://localhost:3020/api

# ============================================
# DOCKER COMPOSE SETTINGS
# ============================================

# These settings are used by docker-compose.yml
# Uncomment and modify if needed

# Restart policy: no, always, on-failure, unless-stopped
# RESTART_POLICY=unless-stopped

# ============================================
# DEVELOPMENT SETTINGS
# ============================================

# For development, you might want to use these settings:
# NODE_ENV=development
# PLATFORM=dev
